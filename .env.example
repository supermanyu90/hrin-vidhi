# Hrin Vidhi — configuration
#
# Copy to `.env` and fill in only what you need. THE DEMO STILL NEEDS NONE OF
# IT: with no keys set, every capability falls back to an offline
# implementation and the full borrower flow completes with no network.
#
# The difference from a mocked-by-default build: the application now reaches
# for a real provider whenever a key is present, and falls back only when one
# is not. Whichever way each capability resolved is reported at /health and
# shown on the badge in the interface, so a fallback is never silent.
#
# Never commit a filled-in .env. `.env` is gitignored.

# ---------------------------------------------------------------------------
# The offline switch
# ---------------------------------------------------------------------------
# false (default) -> use a real provider wherever a key is present; fall back
#                    to the offline implementation for anything unconfigured.
# true            -> force every capability offline, ignoring keys that are
#                    set. An explicit choice: a venue with no WiFi, or a
#                    deliberately deterministic run.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Adapter selection
# ---------------------------------------------------------------------------
# Each takes: auto | mock | <provider name>
#   auto  -> best provider whose key is present, else mock
#   mock  -> force the fixture implementation even with DEMO_MODE=false
#   named -> that provider, and startup fails loudly if its key is missing
#
# Ignored entirely while DEMO_MODE=true, which forces every capability offline.
STT_PROVIDER=auto          # sarvam | bhashini | mock | auto
TRANSLATE_PROVIDER=auto    # sarvam | mock | auto
TTS_PROVIDER=auto          # sarvam | gtts | mock | auto
DOCPARSER_PROVIDER=auto    # anthropic | gemini | mock | auto
LLM_PROVIDER=auto          # anthropic | gemini | mock | auto

# ---------------------------------------------------------------------------
# Anthropic — powers the vision document parser (F2) and prose tightening (F6)
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Depth/cost dial: low | medium | high | xhigh | max.
# Note there is no temperature setting — current Claude models reject sampling
# parameters; output shape is pinned by a JSON schema instead.
ANTHROPIC_EFFORT=medium

# ---------------------------------------------------------------------------
# Google Gemini — the alternative to Anthropic for the same two jobs
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Either provider alone is a complete answer; you do not need both. With both
# set, `auto` picks Anthropic — name a provider above to override, and the two
# can be mixed (Gemini for vision, Claude for prose, or the reverse).
# Requires: pip install google-genai
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Sarvam AI — Indic speech-to-text, translation and text-to-speech
# ---------------------------------------------------------------------------
# Get a key at https://dashboard.sarvam.ai/
# Covers hi, mr, ta, te, en. Bhojpuri has no model — requests fall back to Hindi.
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Bhashini (Govt. of India ULCA) — alternative Indic speech stack
# ---------------------------------------------------------------------------
# Register at https://bhashini.gov.in/ulca
# NOTE: the real Bhashini flow is two-step (pipeline config, then compute).
# Only the compute call is implemented — wire the config step before production.
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# ---------------------------------------------------------------------------
# Provider timeout
# ---------------------------------------------------------------------------
# Wall-clock ceiling on a single provider call. SDKs retry internally with
# backoff, so a transient 503 or a 429 can otherwise stretch one upload into
# minutes while the borrower watches a spinner — and Vercel kills the function
# at 30s regardless. Past this we abandon the provider and fall back, and the
# badge in the interface says so.
PROVIDER_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# false -> uploaded images and transcripts live in memory for the request only.
# Turn this on only with the borrower's explicit consent.
PERSIST_UPLOADS=false
SESSION_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Retrieval (RAG over backend/corpus)
# ---------------------------------------------------------------------------
# Below RAG_MIN_SCORE we answer "couldn't confirm" instead of citing.
# Raising it makes the assistant more cautious, never more inventive.
RAG_MIN_SCORE=0.18
RAG_TOP_K=4
EMBEDDING_MODEL=all-MiniLM-L6-v2
